    "BACKPACK_CONTAINER", "NUM_BAG_FRAMES", "ITEM_QUALITY_COLORS",
    "CANCEL", "YES", "NO", "ACCEPT", "CLOSE", "ITEM_OPENABLE",

    "date", "time", "strsplit", "strjoin", "strtrim", "tinsert", "tremove", "wipe",
    "format", "gsub", "strfind", "strmatch", "strsub", "strlower", "strupper",

    "Auctionator", "Bagnon"
  ]
}
